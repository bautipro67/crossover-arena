# Cache del editor de Godot
.godot/
*.translation

# Builds exportados: se regeneran con
#   godot --headless --path . --export-release "Windows Desktop" build/windows/CrossoverArena.exe
build/

# Sistema
Thumbs.db
desktop.ini

# Voces grabadas: los audios NO van al repositorio publico.
#
# El codigo que las usa si va —esta en sfx.gd y funciona para cualquiera— pero los
# archivos de audio se quedan en la maquina. Subirlos a un repo publico de GitHub es
# republicarlos, que es una cosa distinta de usarlos en el build propio, y es gratis
# no hacerlo: el juego funciona igual y el que no los tenga oye la voz sintetizada.
assets/audio/*.ogg
assets/audio/*.wav
assets/audio/*.mp3
assets/audio/*.import
